{
  "expo": {
    "name": "Vokabula",
    "slug": "vokabula",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.vokabula.learn"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F5E4E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.vokabula.learn"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Vokabula",
      "themeColor": "#1F5E4E",
      "backgroundColor": "#EEF1EC",
      "lang": "de"
    },
    "experiments": {
      "baseUrl": "/vokabula"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Vokabula nutzt deine Fotos, um Vokabellisten daraus zu lesen.",
          "cameraPermission": "Vokabula nutzt die Kamera, um Vokabellisten abzufotografieren."
        }
      ]
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1F5E4E"
    }
  }
}